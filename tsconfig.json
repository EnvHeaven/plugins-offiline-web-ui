{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Node",
    "strict": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "useDefineForClassFields": false,
    "experimentalDecorators": true,
    "lib": [
      "ES2022",
      "DOM"
    ],
    "baseUrl": ".",
    "paths": {
      "@jovdk-web": ["libs/JovDK-Web/index.ts"],
      "@jovdk-web/*": ["libs/JovDK-Web/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "tests/**/*.ts",
    "libs/**/*.ts"
  ],
  "exclude": [
    "libs/**/*.spec.ts"
  ]
}
